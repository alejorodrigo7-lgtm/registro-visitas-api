{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "GOOGLE_SERVICES_FILE": "$GOOGLE_SERVICES_FILE"
      }
    }
  },
  "submit": {
    "production": {}
  }
}