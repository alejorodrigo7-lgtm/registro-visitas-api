{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "jsEngine": "jsc"
      },
      "ios": {
        "jsEngine": "jsc"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "jsEngine": "jsc"
      },
      "ios": {
        "jsEngine": "jsc"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "jsEngine": "jsc"
      },
      "ios": {
        "jsEngine": "jsc"
      }
    }
  },
  "submit": {
    "production": {}
  }
}