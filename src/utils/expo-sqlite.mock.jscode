      { header: 'Cuenta', key: 'cuenta', width: 35 },
      { header: 'Estado', key: 'estado', width: 15 },
    ];
    
    for (const d of depositos) {
      worksheet.addRow({
        fecha: d.fecha ? new Date(d.fecha).toLocaleDateString('es-ES') : '',
        zona: d.zona || '',
        nombre: d.nombre || '',
        cuenta: d.cuenta || '',
        estado: d.estado || '',
